# ---------------------------------------------------------------------------
# .env.docker.example — copy to `.env` (docker compose reads it for
# interpolation and the `api` service uses it as its env_file):
#   cp .env.docker.example .env
# Then fill in REAL values. The stack refuses to start when the required ones
# are missing. `.env` is git-ignored and never uploaded.
# ---------------------------------------------------------------------------

# ================= Django ===================================================
DJANGO_ENV=production
DJANGO_DEBUG=0
# 50+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
# Comma-separated hostnames users actually reach (the host nginx server_names).
# 127.0.0.1 is required for the api container's internal healthcheck.
DJANGO_ALLOWED_HOSTS=miyartrading.com,www.miyartrading.com,api.miyartrading.com,127.0.0.1
# The frontend calls the API same-origin (/api), so leave CORS empty.
# Only set this if the browser talks to the API from a *different* origin:
CORS_ALLOWED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# ----- Optional: auto-create the first superuser on first boot -------------
# If both are set, `manage.py seed` creates the admin. After first boot you
# can delete them from .env.
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me-strong-password

# ----- Throttles (requests/minute) -----------------------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=6000/min
THROTTLE_AUTH=20/min

# ================= Database ================================================
DB_ENGINE=postgres
DB_NAME=miyartrading
DB_USER=miyartrading
# Strong password, used by postgres + api (generate one per environment).
DB_PASSWORD=change-me-strong-db-password

# ================= Cache (Redis) ===========================================
REDIS_PASSWORD=change-me-strong-redis-password

# ================= Email (SMTP) ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Miyar Trading <no-reply@miyartrading.com>

# ================= URLs (frontend + API) ====================================
# App URLs live here — nothing is hardcoded.
#
# FE -> API base URL (baked into the frontend build). Same-origin is the
# recommended setup: the host nginx (and the FE container) proxy /api to the
# API, so no CORS is needed:
VITE_API_BASE=/api
# Host loopback port the host nginx proxies miyartrading.com to (FE container):
HTTP_PORT=8080
# Host loopback port the host nginx proxies api.miyartrading.com to (Django):
API_HOST_PORT=8000

# ================= PayRam gateway ==========================================
# Matches the `payram_mode` the Django admins set (test | production).
# BASE_URL/API keys are ALSO editable in Admin -> Payments; env vars take the
# same effect and win for `PAYRAM_MODE`.
PAYRAM_MODE=test
# URLs must start with http:// or https:// (in-container: http://localhost:8081
# maps to PayRam's HTTP port; use your public https URL in production).
PAYRAM_BASE_URL_TEST=http://localhost:8081
PAYRAM_API_KEY_TEST=change-me
PAYRAM_BASE_URL_PRODUCTION=https://pay.example.com
PAYRAM_API_KEY_PRODUCTION=change-me
# ---- PayRam server itself (only used with docker-compose.payram.yml) -------
# Encryption key for hot-wallet keys: openssl rand -hex 32 (keep forever!)
PAYRAM_AES_KEY=change-me-openssl-rand-hex-32
PAYRAM_DB_PASSWORD=change-me-payram-db-password
PAYRAM_NETWORK=testnet            # testnet | mainnet
PAYRAM_SERVER=DEVELOPMENT         # DEVELOPMENT | PRODUCTION
PAYRAM_HTTP_PORT=8081             # host loopback -> PayRam :80 (nginx proxies payram.miyartrading.com here)
PAYRAM_HTTPS_PORT=8443            # host loopback -> PayRam :443 (keep :443 inside)
PAYRAM_IMAGE=payramapp/payram:latest   # use payramapp/payram:latest-arm64 on ARM