# ---------------------------------------------------------------------------
# MYX app - deployment environment
#
# Generated file. NOT committed (.gitignore lists .env).
# .env.docker.example is the tracked template - keep it in sync.
#
#   cp .env.docker.example .env      # then fill in real values
#   docker compose up -d --build
#
# docker-compose.yml hard-fails if DB_PASSWORD, REDIS_PASSWORD or
# DJANGO_ALLOWED_HOSTS are empty, so those three must always be set.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Core Django -----------------------------------------------------------
# DJANGO_ENV / DJANGO_DEBUG are deliberately NOT set here.
#   docker-compose.yml sets both in its environment block, which overrides
#   env_file, so production still gets DEBUG=0 + HTTPS redirects. Leaving them
#   out lets a local manage.py runserver default to development mode --
#   putting them here would redirect plain http://localhost to https and break
#   local testing.
DJANGO_SECRET_KEY=change-me-please
DJANGO_LOG_LEVEL=INFO
# Comma separated. Must include every hostname the app is served on.
DJANGO_ALLOWED_HOSTS=myxtrading.org,www.myxtrading.org,api.myxtrading.org,188.245.9.187,localhost,127.0.0.1
# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://myxtrading.org,https://www.myxtrading.org

# --- PostgreSQL ------------------------------------------------------------
# DB_ENGINE / DB_HOST / DB_PORT are injected by docker-compose.yml.
DB_NAME=miyartrading
DB_USER=miyartrading
DB_PASSWORD=change-me
# Pool sizing. Defaults suit a ~4 GB host.
DB_MAX_CONNECTIONS=200
DB_SHARED_BUFFERS=384MB

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- Gunicorn / Proxy ------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
CSRF_TRUSTED_ORIGINS=https://myxtrading.org,https://www.myxtrading.org,https://api.myxtrading.org

# --- Caching ---------------------------------------------------------------
MARKET_CACHE_SECONDS=30
PUBLIC_SETTINGS_CACHE_SECONDS=60

# --- Timezone --------------------------------------------------------------
# Latent issue: the test suite was only ever run under UTC. Changing this
# without re-running the tests can surface off-by-one-day failures.
TIME_ZONE=UTC

# --- Branding --------------------------------------------------------------
BRAND_NAME=MYX app
DEFAULT_FROM_EMAIL=MYX app <no-reply@myxtrading.org>

# --- Email (OTP + transactional) ------------------------------------------
# Console backend prints every message to the container log instead of sending
# it. Safe default: nothing is delivered to a real inbox until credentials exist.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Email OTP via Brevo (recommended, free tier) -------------------------
# 1. Sign up at https://www.brevo.com
# 2. SMTP & API -> API keys -> generate a key          -> BREVO_API_KEY
# 3. Senders -> add and verify the miyartrading.com domain -> BREVO_SENDER_EMAIL
# When BREVO_API_KEY is set, verification mail goes out over Brevo's HTTP API
# and the SMTP block above is ignored for OTP. Leave blank to keep console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- SMS OTP --------------------------------------------------------------
# console = print codes to the server log (demo only)
# twilio   = send real SMS (needs the three TWILIO_* values)
# none     = disable SMS entirely
# The UI hides the SMS option unless a real provider is configured, so
# console is safe for a live deployment.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments (Plisio) -----------------------------------------------------
PLISIO_API_KEY=
PLISIO_CALLBACK_URL=
# Hosted gateway, no extra container. Set the key in the admin panel
# (Settings -> Payment gateway) rather than here.

# --- Payments (BlockBee) ---------------------------------------------------
# Adding BLOCKBEE_API_KEY switches new deposits/payouts to BlockBee (set
# payment_gateway=plisio in the admin panel to override). Payouts require an
# API Key V2 and a funded Self-Custodial Wallet.
BLOCKBEE_API_KEY=
PAYMENT_CALLBACK_URL=https://api.myxtrading.org/api/gateway/webhook/

# --- Admin superuser (created on first boot by docker-entrypoint.sh) ------
# Leave both blank to skip creation, then run:
#   docker compose exec api python manage.py createsuperuser
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Background poller -----------------------------------------------------
# Reconciles payments/payouts. Disable on a scheduler-only host so two
# processes do not both claim the same work.
MIYARTRADING_DISABLE_POLLER=0
MIYARTRADING_POLL_INTERVAL=60
