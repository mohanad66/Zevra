# Mobile (Capacitor) LOCAL build config, loaded by `vite build --mode mobile`.
# Used for on-device testing against a Django dev server on this machine.
#
# The phone must reach this PC over the Wi-Fi LAN, and 127.0.0.1 on a phone means
# the phone itself - so use the PC's LAN address, not loopback.
VITE_API_BASE=http://192.168.1.2:8001/api
#
# Before testing, on the PC run:
#   python manage.py runserver 0.0.0.0:8001
# and make sure the phone is on the same Wi-Fi network.
#
# This build talks plain HTTP, so it is only safe because the DEBUG variant
# permits cleartext (android/app/src/debug/res/xml/network_security_config.xml).
# Never ship this build to Play - use `npm run build:mobile:release`.
