# Backend API base URL used by the Capacitor Android app.
# Loaded by `vite build --mode mobile` (npm run build:mobile).
#
# This value is baked into the APK at build time - it is NOT read at runtime, so
# changing it here requires a rebuild and reinstall.
#
# The base MUST include /api: the app's axios instance uses this as its baseURL
# and appends paths like /login, so omitting /api makes every request 404.
# Trailing slashes are stripped automatically.
VITE_API_BASE=https://api.miyartrading.com/api
#
# The app runs from origin https://localhost inside the WebView, so the API must
# allow that origin in CORS or every request fails. settings.py appends it
# automatically, but the backend must be DEPLOYED for this to take effect.
#
# Note: use https, not http. The server 301-redirects http -> https, and the
# release/Play build blocks cleartext traffic outright, so http can never work
# in a store build.
