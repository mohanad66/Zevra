# Mobile (Capacitor) build config, loaded by `vite build --mode mobile`.
#
# On a phone, 127.0.0.1 points at the phone itself — NOT your computer. For a
# store build this MUST be the public HTTPS API, never a LAN address:
VITE_API_BASE=https://api.miyartrading.com/api
#
# For local device testing instead, use your computer's LAN IP and run Django on
# 0.0.0.0:8001, e.g. http://192.168.1.20:8001/api
#
# Note: the packaged app's WebView origin is https://localhost. The API must
# allow that origin in CORS (settings.py appends it automatically).
